 func (r *IntegrationRepository) SaveDevice(ctx context.Context, device d.Device) error {
 	return r.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// Match DeleteAccount's users -> push_devices lock order. Authentication
+		// may have succeeded before deletion; retain this lock through the upsert
+		// so deletion either removes our device or we observe the erased account.
+		var account struct {
+			Registered bool
+			Blocked    bool
+			Guest      bool
+		}
+		found := tx.Raw(`SELECT password_hash<>'' AS registered, is_blocked AS blocked,
+			guest_conference_id IS NOT NULL AS guest FROM users WHERE id=? FOR UPDATE`, device.UserID).Scan(&account)
+		if found.Error != nil {
+			return found.Error
+		}
+		if found.RowsAffected == 0 || !account.Registered {
+			return apperrors.ErrUnauthorized
+		}
+		if account.Blocked {
+			return apperrors.ErrAccountBlocked
+		}
+		if account.Guest {
+			return apperrors.ErrForbidden
+		}
 		if err := tx.Exec("SELECT pg_advisory_xact_lock(hashtextextended(?,0))", device.UserID+":devices").Error; err != nil {
 			return err
 		}
